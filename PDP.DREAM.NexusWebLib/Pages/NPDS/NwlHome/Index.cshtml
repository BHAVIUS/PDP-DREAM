  </li>
  <li>
    User: 
    <a asp-page="@DepNexusServiceUserResreps">@DepNexusServiceUserResreps</a>
  </li>
  <li>
    Agent: <a asp-page="@DepAgentModeHelp">@DepAgentModeHelp</a> |
    <a asp-page="@DepNexusServiceAgentResreps">@DepNexusServiceAgentResreps</a>
  </li>
  <li>
    Author: <a asp-page="@DepAuthorModeHelp">@DepAuthorModeHelp</a> |
    <a asp-page="@DepNexusServiceAuthorResreps">@DepNexusServiceAuthorResreps</a>
  </li>
  <li>
    Editor: <a asp-page="@DepEditorModeHelp">@DepEditorModeHelp</a> |
    <a asp-page="@DepNexusServiceEditorResreps">@DepNexusServiceEditorResreps</a>
  </li>
  <li>
    Admin: <a asp-page="@DepAdminModeHelp">@DepAdminModeHelp</a> |
