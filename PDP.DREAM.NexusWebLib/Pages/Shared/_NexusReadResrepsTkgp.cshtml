col.Bound(row => row.HasPriority).Title("Priority").Width(FipmpWidth)
.HeaderHtmlAttributes(new { title = "EntityLabel has Priority in integer range [0,1,...,255]" });
col.Bound(row => row.IsMarked).Title("Marked").Width(FipmpWidth)
