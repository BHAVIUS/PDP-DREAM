.Events(evn => evn.Error("HandleAjaxErrors"))) // end DataSource
.Columns(col => {
col.Bound(row => row.RRFgroupGuid).Hidden(true);
col.Bound(row => row.RRRecordGuid).Hidden(true);
col.Bound(row => row.HasIndex).Title("Index").Width(FipmpWidth)
