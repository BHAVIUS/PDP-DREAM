@{
  bool userAuth = (Model.QebRcp.IsAuthenticated ?? false);
  string userName = (User?.Identity?.Name ?? ESS);
}

<span>
  NwlHome:
  <a asp-page="@DepNwlHomeIndex">Index</a>
  <span> | </span>
  @if (userAuth)
  {
    <a asp-page="@DepUserModeDisplayProfile">@userName</a>
    @if (PDPSS.AppUseDevtestFeature)
    {
      <span> | </span>
      <a asp-page="@DepNexusServiceIndex">NexusApi</a>
      <span> | </span>
      <a asp-page="@DepNwlHomeDevTest">DevTest</a>
    }
  }
  else
  {
    <a asp-page="@DepAnonModeLoginUser">LoginUser</a>
  }
</span>

