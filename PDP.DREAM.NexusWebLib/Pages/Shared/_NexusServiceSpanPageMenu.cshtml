@{
  bool userAuth = (Model.QebiRcp.IsAuthenticated ?? false);
  string userName = (Model.QebiRcp.UserName ?? ESS);
  <span>
    NexusService:
    <a href="@DepNexusServiceIndex">Index</a>
    <span> | </span>
    <a href="@DepNexusServiceAnonResreps">AnonResreps</a>
    @if (userAuth)
    {
      string paramsPath = (Model.NPDSCW.ResrepSrch4ParPartPath ?? ESS);
      string userResreps = DepNexusServiceUserResreps + paramsPath;
      string agentResreps = DepNexusServiceAgentResreps + paramsPath;
      string authorResreps = DepNexusServiceAuthorResreps + paramsPath;
      string reviewerResreps = DepNexusServiceReviewerResreps + paramsPath;
      string editorResreps = DepNexusServiceEditorResreps + paramsPath;
      string adminResreps = DepNexusServiceAdminResreps + paramsPath;
      <span> | </span>
      <a href="@userResreps">UserResreps</a>
      <span> | </span>
      <a href="@agentResreps">AgentResreps</a>
      <span> | </span>
      <a href="@authorResreps">AuthorResreps</a>
      <span> | </span>
      <a href="@reviewerResreps">ReviewerResreps</a>
      <span> | </span>
      <a href="@editorResreps">EditorResreps</a>
      <span> | </span>
      <a href="@adminResreps">AdminResreps</a>
    }
  </span>
}
