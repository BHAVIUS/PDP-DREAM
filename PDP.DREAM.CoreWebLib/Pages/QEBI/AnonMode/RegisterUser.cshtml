@page
@attribute [PdpRazorPageRoute(DepCoreWebLib, DepqAnonModeRegisterUser)]
@model QebiAnonModeRegisterUser
@{
  PdpSiteRazorModel psrm = Model.PSRM;
  var pdpFormGroup = "form-group mb-3 col-md-3";
}
@Html.Raw(psrm.FormatBodyTitle())
@if (!string.IsNullOrEmpty(psrm.RazorBodyMenu))
{
  <p><partial name="@psrm.RazorBodyMenu" /></p>
}

@if (Model.UXM.FormCompleted)
{
  <p class="pdpTaskPassed">
    Thank you for registering.
    A security token has been sent to you for verification of your email address.
    Please check your email and click on the confirmation link to complete your registration.
  </p>
}
else
{
  <form id="frmRegisterUser" asp-page="@DepqAnonModeRegisterUser"
        method="post" role="form" class="form-horizontal">
    <p>
      Use the form below to register a new user account.
    </p>
    <div class="@pdpFormGroup">
      @Html.AntiForgeryToken()
      @Html.HiddenFor(m => m.UXM.FormTitle, new { Value = Model.UXM.FormTitle })
      @Html.ValidationSummary("", new { @class = "text-danger" })
    </div>
    <div class="@pdpFormGroup">
      @Html.LabelFor(m => m.UXM.FirstName, new { @class = "form-label" })
      @Html.TextBoxFor(m => m.UXM.FirstName, new { @class = "form-control" })
      @Html.ValidationMessageFor(m => m.UXM.FirstName, null, new { @class = "form-labeltext-danger" })
    </div>
    <div class="@pdpFormGroup">
      @Html.LabelFor(m => m.UXM.LastName, new { @class = "form-label" })
      @Html.TextBoxFor(m => m.UXM.LastName, new { @class = "form-control " })
      @Html.ValidationMessageFor(m => m.UXM.LastName, null, new { @class = "form-labeltext-danger" })
    </div>
    <div class="@pdpFormGroup">
      @Html.LabelFor(m => m.UXM.EmailAddress, new { @class = "form-label" })
      @Html.TextBoxFor(m => m.UXM.EmailAddress, new { @class = "form-control " })
      @Html.ValidationMessageFor(m => m.UXM.EmailAddress, null, new { @class = "form-labeltext-danger" })
    </div>
    <div class="@pdpFormGroup">
      @Html.LabelFor(m => m.UXM.EmailAlternate, new { @class = "form-label" })
      @Html.TextBoxFor(m => m.UXM.EmailAlternate, new { @class = "form-control " })
      @Html.ValidationMessageFor(m => m.UXM.EmailAlternate, null, new { @class = "form-labeltext-danger" })
    </div>
    <div class="@pdpFormGroup">
      @Html.LabelFor(m => m.UXM.PhoneNumber, new { @class = "form-label" })
      @Html.TextBoxFor(m => m.UXM.PhoneNumber, new { @class = "form-control " })
      @Html.ValidationMessageFor(m => m.UXM.PhoneNumber, null, new { @class = "form-labeltext-danger" })
    </div>
    <div class="@pdpFormGroup">
      @Html.LabelFor(m => m.UXM.PhoneAlternate, new { @class = "form-label" })
      @Html.TextBoxFor(m => m.UXM.PhoneAlternate, new { @class = "form-control " })
      @Html.ValidationMessageFor(m => m.UXM.PhoneAlternate, null, new { @class = "form-labeltext-danger" })
    </div>
    <div class="@pdpFormGroup">
      @Html.LabelFor(m => m.UXM.UserName, new { @class = "form-label" })
      @Html.TextBoxFor(m => m.UXM.UserName, new { @class = "form-control" })
      @Html.ValidationMessageFor(m => m.UXM.UserName, null, new { @class = "form-labeltext-danger" })
    </div>
    <div class="@pdpFormGroup">
      @Html.LabelFor(m => m.UXM.PassWord, new { @class = "form-label" })
      @Html.PasswordFor(m => m.UXM.PassWord, new { @class = "form-control" })
      @Html.ValidationMessageFor(m => m.UXM.PassWord, null, new { @class = "form-label text-danger" })
    </div>
    <div class="@pdpFormGroup">
      @Html.LabelFor(m => m.UXM.AltPassword, new { @class = "form-label" })
      @Html.PasswordFor(m => m.UXM.AltPassword, new { @class = "form-control" })
      @Html.ValidationMessageFor(m => m.UXM.AltPassword, null, new { @class = "form-label text-danger" })
    </div>
    <div class="@pdpFormGroup">
      @Html.LabelFor(m => m.UXM.SecurityQuestion, new { @class = "form-label" })
      @Html.TextBoxFor(m => m.UXM.SecurityQuestion, new { @class = "form-control" })
      @Html.ValidationMessageFor(m => m.UXM.SecurityQuestion, null, new { @class = "form-label text-danger" })
    </div>
    <div class="@pdpFormGroup">
      @Html.LabelFor(m => m.UXM.SecurityAnswer, new { @class = "form-label" })
      @Html.TextBoxFor(m => m.UXM.SecurityAnswer, new { @class = "form-control" })
      @Html.ValidationMessageFor(m => m.UXM.SecurityAnswer, null, new { @class = "form-label text-danger" })
    </div>
    <div class="@pdpFormGroup">
      @Html.LabelFor(m => m.UXM.SimpleCaptcha, new { @class = "form-label" })
      @Html.TextBoxFor(m => m.UXM.SimpleCaptcha, new { @class = "form-control" })
      @Html.ValidationMessageFor(m => m.UXM.SimpleCaptcha, null, new { @class = "form-label text-danger" })
    </div>
    <br />
    <button id="btnRegisterUser" type="submit" class="btn btn-outline-primary">Register User</button>
  </form>
}
