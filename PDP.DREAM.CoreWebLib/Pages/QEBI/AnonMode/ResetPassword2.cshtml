@page
@model QebiAnonModeResetPassword2
@{
  PdpSiteRazorModel psrm = Model.PSRM;
  var pdpFormGroup = "form-group mb-3 col-md-3";
}
@Html.Raw(psrm.FormatBodyTitle())

@if (Model.UXM.FormCompleted)
{
  <p class="pdpTaskPassed">
    A security token has been sent to you for resetting your password.
    Please check your email and click on the confirmation link to complete the change.
  </p>
}
else
{
  <form id="frmResetPassword2" asp-page="@DepqAnonModeResetPassword2"
      method="post" role="form" class="form-horizontal">
    <p>
      To reset your password, please enter your username and then answer the security question.
    </p>
    <div class="@pdpFormGroup">
      @Html.AntiForgeryToken()
      @Html.HiddenFor(m => m.UXM.FormTitle, new { Value = Model.UXM.FormTitle })
      @Html.ValidationSummary("", new { @class = "text-danger" })
    </div>
    <div class="@pdpFormGroup">
      @Html.LabelFor(m => m.UXM.UserName, new { @class = "form-label" })
      @Html.TextBoxFor(m => m.UXM.UserName, new { @class = "form-control", Value = Model.UXM.UserName })
      @Html.ValidationMessageFor(m => m.UXM.UserName, null, new { @class = "form-label text-danger" })
    </div>
    <div class="@pdpFormGroup">
      @Html.LabelFor(m => m.UXM.SecurityQuestion, new { @class = "form-label" })
      @Html.TextBoxFor(m => m.UXM.SecurityQuestion, new { @class = "form-control", Value = Model.UXM.SecurityQuestion })
      @Html.ValidationMessageFor(m => m.UXM.SecurityQuestion, null, new { @class = "form-label text-danger" })
    </div>
    <div class="@pdpFormGroup">
      @Html.LabelFor(m => m.UXM.SecurityAnswer, new { @class = "form-label" })
      @Html.TextBoxFor(m => m.UXM.SecurityAnswer, new { @class = "form-control" })
      @Html.ValidationMessageFor(m => m.UXM.SecurityAnswer, null, new { @class = "form-label text-danger" })
    </div>
    <br />
    <button id="btnResetPassword2" type="submit" class="btn btn-outline-primary">Next Step</button>
  </form>
}
