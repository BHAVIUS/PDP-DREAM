@page
@model QebiAnonModeResetPassword3
@{
  PdpSiteRazorModel psrm = Model.PSRM;
  var pdpFormGroup = "form-group mb-3 col-md-3";
}
@Html.Raw(psrm.FormatBodyTitle())

@if (Model.UXM.FormCompleted)
{
  <p class="pdpTaskPassed">
    Your password has been reset.
  </p>
}
else
{
  <form id="frmResetPassword3" asp-page="@DepqAnonModeResetPassword3"
      method="post" role="form" class="form-horizontal">
    <p>
      To reset your password, please enter your username and then answer the security question.
    </p>
    <div class="form-group mb3">
      @Html.AntiForgeryToken()
      @Html.HiddenFor(m => m.UXM.FormTitle, new { Value = Model.UXM.FormTitle })
      @Html.ValidationSummary("", new { @class = "text-danger" })
    </div>
    <div class="@pdpFormGroup">
      @Html.LabelFor(m => m.UXM.UserName, new { @class = "form-label" })
      @Html.TextBoxFor(m => m.UXM.UserName, new { @class = "form-control", Value = Model.UXM.UserName })
      @Html.ValidationMessageFor(m => m.UXM.UserName, null, new { @class = "form-label text-danger" })
    </div>
    <div class="@pdpFormGroup">
      @Html.LabelFor(m => m.UXM.SecurityToken, new { @class = "form-label" })
      @Html.TextBoxFor(m => m.UXM.SecurityToken, new { @class = "form-control ", Value = Model.UXM.SecurityToken })
      @Html.ValidationMessageFor(m => m.UXM.SecurityToken, null, new { @class = "form-label text-danger" })
    </div>
    <div class="@pdpFormGroup">
      @Html.LabelFor(m => m.UXM.NewPassword, new { @class = "form-label" })
      @Html.PasswordFor(m => m.UXM.NewPassword, new { @class = "form-control" })
      @Html.ValidationMessageFor(m => m.UXM.NewPassword, null, new { @class = "form-label text-danger" })
    </div>
    <div class="@pdpFormGroup">
      @Html.LabelFor(m => m.UXM.AltPassword, new { @class = "form-label" })
      @Html.PasswordFor(m => m.UXM.AltPassword, new { @class = "form-control" })
      @Html.ValidationMessageFor(m => m.UXM.AltPassword, null, new { @class = "form-label text-danger" })
    </div>
    <br />
    <button id="btnResetPassword3" type="submit" class="btn btn-outline-primary">Reset Password</button>
  </form>
}
