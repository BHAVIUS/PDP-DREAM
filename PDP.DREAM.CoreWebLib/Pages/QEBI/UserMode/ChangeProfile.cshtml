@page
@attribute [PdpRazorPageRoute(DepCoreWebLib, DepqUserModeChangeProfile)]
@model QebiUserModeChangeProfile
@{
  PdpSiteRazorModel psrm = Model.PSRM;
  NpdsClientWrace npdscw = Model.NPDSCW;
  var pdpFormGroup = "form-group col-md-6 mb-3";
  var pdpFormLabel = "form-label col-md-3";
}
@Html.Raw(psrm.FormatBodyTitle())
@if (!string.IsNullOrEmpty(psrm.RazorBodyMenu))
{
  <p><partial name="@psrm.RazorBodyMenu" /></p>
}

@if (Model.UXM.FormCompleted)
{
  <p class="pdpTaskPassed">Your profile has been changed.</p>
}
else
{
  <form id="frmChangeProfile" asp-page="@DepqUserModeChangeProfile"
        method="post" role="form" class="form-horizontal">
    <p>
      Use the form below to change your profile.
    </p>
    <div class="@pdpFormGroup">
      @Html.AntiForgeryToken()
      @Html.HiddenFor(m => m.UXM.FormTitle, new { Value = Model.UXM.FormTitle })
      @Html.HiddenFor(m => m.UXM.SecurityToken, new { Value = Model.UXM.SecurityToken })
      @Html.HiddenFor(m => m.UXM.UserGuid, new { Value = Model.UXM.UserGuid })
      @Html.HiddenFor(m => m.UXM.UserName, new { Value = Model.UXM.UserName })
      @Html.ValidationSummary("", new { @class = "text-danger" })
    </div>
    <div class="@pdpFormGroup">
      @Html.LabelFor(m => m.UXM.FirstName, new { @class = pdpFormLabel })
      @Html.TextBoxFor(m => m.UXM.FirstName, new { @class = "form-control" })
      @Html.ValidationMessageFor(m => m.UXM.FirstName, null, new { @class = "form-label text-danger" })
    </div>
    <div class="@pdpFormGroup">
      @Html.LabelFor(m => m.UXM.LastName, new { @class = pdpFormLabel })
      @Html.TextBoxFor(m => m.UXM.LastName, new { @class = "form-control" })
      @Html.ValidationMessageFor(m => m.UXM.LastName, null, new { @class = "form-label text-danger" })
    </div>
    @if (!PDPSS.AppUseSecureAlias)
    {
      <div class="@pdpFormGroup">
        @Html.LabelFor(m => m.UXM.UserAlias, new { @class = pdpFormLabel })
        @Html.TextBoxFor(m => m.UXM.UserAlias, new { @class = "form-control" })
        @Html.ValidationMessageFor(m => m.UXM.UserAlias, null, new { @class = "form-label text-danger" })
      </div>
    }
    <div class="@pdpFormGroup">
      @Html.LabelFor(m => m.UXM.PhoneNumber, new { @class = pdpFormLabel  })
      @Html.TextBoxFor(m => m.UXM.PhoneNumber, new { @class = "form-control" })
      @Html.ValidationMessageFor(m => m.UXM.PhoneNumber, null, new { @class = "form-label text-danger" })
    </div>
    <div class="@pdpFormGroup">
      @Html.LabelFor(m => m.UXM.PhoneAlternate, new { @class = pdpFormLabel })
      @Html.TextBoxFor(m => m.UXM.PhoneAlternate, new { @class = "form-control" })
      @Html.ValidationMessageFor(m => m.UXM.PhoneAlternate, null, new { @class = "form-label text-danger" })
    </div>
    <div class="@pdpFormGroup">
      @Html.LabelFor(m => m.UXM.WebsiteAddress, new { @class = pdpFormLabel  })
      @Html.TextBoxFor(m => m.UXM.WebsiteAddress, new { @class = "form-control" })
      @Html.ValidationMessageFor(m => m.UXM.WebsiteAddress, null, new { @class = "form-label text-danger" })
    </div>
    <div class="@pdpFormGroup">
      @Html.LabelFor(m => m.UXM.Organization, new { @class = pdpFormLabel })
      @Html.TextBoxFor(m => m.UXM.Organization, new { @class = "form-control" })
      @Html.ValidationMessageFor(m => m.UXM.Organization, null, new { @class = "form-label text-danger" })
    </div>
    <div class="@pdpFormGroup">
      @Html.LabelFor(m => m.UXM.SecurityQuestion, new { @class = pdpFormLabel  })
      @Html.TextBoxFor(m => m.UXM.SecurityQuestion, new { @class = "form-control" })
      @Html.ValidationMessageFor(m => m.UXM.SecurityQuestion, null, new { @class = "form-label text-danger" })
    </div>
    <div class="@pdpFormGroup">
      @Html.LabelFor(m => m.UXM.SecurityAnswer, new { @class = pdpFormLabel  })
      @Html.TextBoxFor(m => m.UXM.SecurityAnswer, new { @class = "form-control" })
      @Html.ValidationMessageFor(m => m.UXM.SecurityAnswer, null, new { @class = "form-label text-danger" })
    </div>
    <div class="@pdpFormGroup">
      @Html.LabelFor(m => m.UXM.PassWord, new { @class = pdpFormLabel  })
      @Html.PasswordFor(m => m.UXM.PassWord, new { @class = "form-control" })
      @Html.ValidationMessageFor(m => m.UXM.PassWord, null, new { @class = "form-label text-danger" })
    </div>
    <br />
    <button id="btnChangeProfile" type="submit" class="btn btn-outline-primary">Change Profile</button>
  </form>
}
