@page
@attribute [PdpRazorPageRoute(DepCoreWebLib, DepqUserModeDisplayProfile)]
@model QebiUserModeDisplayProfile
@{
  PdpSiteRazorModel psrm = Model.PSRM;
  NpdsClientWrace npdscw = Model.NPDSCW;
  var pdpFormGroup = "form-group col-md-6 mb-3";
  var pdpFormLabel = "form-label col-md-3";
}
@Html.Raw(psrm.FormatBodyTitle())
@if (!string.IsNullOrEmpty(psrm.RazorBodyMenu))
{
  <p><partial name="@psrm.RazorBodyMenu" /></p>
}

<form id="frmDisplayProfile" asp-page="@DepqUserModeDisplayProfile"
      method="get" role="form" class="form-horizontal">
  <div class="@pdpFormGroup">
    @Html.LabelFor(m => m.UXM.FirstName, new { @class = pdpFormLabel })
    @Html.TextBoxFor(m => m.UXM.FirstName, new { @class = "form-control", disabled = "disabled" })
  </div>
  <div class="@pdpFormGroup">
    @Html.LabelFor(m => m.UXM.LastName, new { @class = pdpFormLabel })
    @Html.TextBoxFor(m => m.UXM.LastName, new { @class = "form-control", disabled = "disabled" })
  </div>
  <div class="@pdpFormGroup">
    @Html.LabelFor(m => m.UXM.UserName, new { @class = pdpFormLabel })
    @Html.TextBoxFor(m => m.UXM.UserName, new { @class = "form-control", disabled = "disabled" })
  </div>
  <div class="@pdpFormGroup">
    @Html.LabelFor(m => m.UXM.UserAlias, new { @class = pdpFormLabel })
    @Html.TextBoxFor(m => m.UXM.UserAlias, new { @class = "form-control", disabled = "disabled" })
  </div>
  <div class="@pdpFormGroup">
    @Html.LabelFor(m => m.UXM.RandAlias, new { @class = pdpFormLabel })
    @Html.TextBoxFor(m => m.UXM.RandAlias, new { @class = "form-control", disabled = "disabled" })
  </div>
  <div class="@pdpFormGroup">
    @Html.LabelFor(m => m.UXM.PhoneNumber, new { @class = pdpFormLabel })
    @Html.TextBoxFor(m => m.UXM.PhoneNumber, new { @class = "form-control", disabled = "disabled" })
  </div>
  <div class="@pdpFormGroup">
    @Html.LabelFor(m => m.UXM.PhoneAlternate, new { @class = pdpFormLabel })
    @Html.TextBoxFor(m => m.UXM.PhoneAlternate, new { @class = "form-control", disabled = "disabled" })
  </div>
  <div class="@pdpFormGroup">
    @Html.LabelFor(m => m.UXM.WebsiteAddress, new { @class = pdpFormLabel })
    @Html.TextBoxFor(m => m.UXM.WebsiteAddress, new { @class = "form-control", disabled = "disabled" })
  </div>
  <div class="@pdpFormGroup">
    @Html.LabelFor(m => m.UXM.Organization, new { @class = pdpFormLabel })
    @Html.TextBoxFor(m => m.UXM.Organization, new { @class = "form-control", disabled = "disabled" })
  </div>
  <div class="@pdpFormGroup">
    @Html.LabelFor(m => m.UXM.DateProfileChanged, new { @class = pdpFormLabel })
    @Html.TextBoxFor(m => m.UXM.DateProfileChanged, new { @class = "form-control", disabled = "disabled" })
  </div>
</form>

