@page
@attribute [PdpRazorPageRoute(DepCoreWebLib, DepqUserModeChangeEmail)]
@model QebiUserModeChangeEmail
@{
  PdpSiteRazorModel psrm = Model.PSRM;
  NpdsClientWrace npdscw = Model.NPDSCW;
  var pdpFormGroup = "form-group mb-3 col-md-3";
}
@Html.Raw(psrm.FormatBodyTitle())
@if (!string.IsNullOrEmpty(psrm.RazorBodyMenu))
{
  <p><partial name="@psrm.RazorBodyMenu" /></p>
}

@if (Model.UXM.FormCompleted)
{
  <p class="pdpTaskPassed">
    A security token has been sent to you for verification of your new email address.
    Please check your email and click on the confirmation link to complete the change.
  </p>
}
else
{
  <form id="frmChangeEmail" asp-page="@DepqUserModeChangeEmail"
        method="post" role="form" class="form-horizontal">
    <p>
      Use the form below to change your email address.
    </p>
    <div class="@pdpFormGroup">
      @Html.AntiForgeryToken()
      @Html.HiddenFor(m => m.UXM.FormTitle, new { Value = Model.UXM.FormTitle })
      @Html.HiddenFor(m => m.UXM.RequireSecTok, new { Value = Model.UXM.RequireSecTok })
      @Html.HiddenFor(m => m.UXM.SecurityToken, new { Value = Model.UXM.SecurityToken })
      @Html.HiddenFor(m => m.UXM.UserGuid, new { Value = Model.UXM.UserGuid })
      @Html.HiddenFor(m => m.UXM.UserName, new { Value = Model.UXM.UserName })
      @Html.ValidationSummary("", new { @class = "text-danger" })
    </div>
    <div class="@pdpFormGroup">
      @Html.LabelFor(m => m.UXM.OldEmail, new { @class = "form-label" })
      @Html.TextBoxFor(m => m.UXM.OldEmail, new { @class = "form-control" })
      @Html.ValidationMessageFor(m => m.UXM.OldEmail, null, new { @class = "form-label text-danger" })
    </div>
    <div class="@pdpFormGroup">
      @Html.LabelFor(m => m.UXM.NewEmail, new { @class = "form-label" })
      @Html.TextBoxFor(m => m.UXM.NewEmail, new { @class = "form-control" })
      @Html.ValidationMessageFor(m => m.UXM.NewEmail, null, new { @class = "form-label text-danger" })
    </div>
    <div class="@pdpFormGroup">
      @Html.LabelFor(m => m.UXM.AltEmail, new { @class = "form-label" })
      @Html.TextBoxFor(m => m.UXM.AltEmail, new { @class = "form-control" })
      @Html.ValidationMessageFor(m => m.UXM.AltEmail, null, new { @class = "form-label text-danger" })
    </div>
    <br />
    <button type="submit" class="btn btn-outline-primary">Change Email</button>
  </form>
}

