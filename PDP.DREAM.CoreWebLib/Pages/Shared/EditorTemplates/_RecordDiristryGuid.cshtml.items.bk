@model Guid?

@(
  Html.Kendo().DropDownListFor(m => m)
  .DataValueField("Value").DataTextField("Text").OptionLabel("Select Diristry")
  .BindTo((System.Collections.IEnumerable)NPDSSD.NpdsDdlists.RegcDiristryListItems)
  .HtmlAttributes(new { style = "width: 11em;", title = "Select Nexus Diristry" })
)
