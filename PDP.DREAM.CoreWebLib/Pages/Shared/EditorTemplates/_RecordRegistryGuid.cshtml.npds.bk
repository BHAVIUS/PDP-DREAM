@model Guid?

@(
  Html.Kendo().DropDownListFor(m => m)
  .DataValueField("RecordRegistryGuid").DataTextField("RecordRegistryName").OptionLabel("Select Registry")
  .BindTo((System.Collections.IEnumerable)NPDSSD.NpdsDdlists.RegcRegistryListNpds)
  .HtmlAttributes(new { style = "width: 11em;", title = "Select PORTAL Registry" })
)
