@model Int16

@(
  Html.Kendo().DropDownListFor(m => m)
  .DataValueField("Value").DataTextField("Text")
  .BindTo((System.Collections.IEnumerable)NPDSSD.NpdsDdlists.InfosetDoorsStatusListItems)
  .HtmlAttributes(new { style = "width: 11em;", title = "Select most appropriate InfosetDoorsStatus." })
)

