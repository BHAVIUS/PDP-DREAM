@model Int16

@(
  Html.Kendo().DropDownListFor(p => p)
  .DataValueField("Value").DataTextField("Text").OptionLabel("Select EntityType")
  .BindTo((System.Collections.IEnumerable)NPDSSD.NpdsDdlists.EntityTypeListItems)
  .HtmlAttributes(new { style = "width: 11em;", title = "Select most appropriate EntityType." })
)

