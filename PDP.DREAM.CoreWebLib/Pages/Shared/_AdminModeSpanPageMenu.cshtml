@{
  bool userAuth = (Model.QebRcp.IsAuthenticated ?? false);
  string userName = (User?.Identity?.Name ?? ESS);
  NpdsClientWrace wrace = Model.WRACE;
  var keys = new Dictionary<string, string>() { ["ugk"] = wrace.ClientUserKey, ["agk"] = wrace.ClientAgentKey, ["sgk"] = wrace.ClientSessionKey };
  if (userAuth)
  {
    <span>
      AdminMode:
      <a asp-page="@DepAdminModeIndex" asp-all-route-data="@keys">Index</a>
      <span> | </span>
      <a asp-page="@DepAdminModeHelp">Help</a>
      <span> | </span>
      <a asp-page="@DepAdminModeViewQebiRoles">View Roles</a>
      <span> | </span>
      <a asp-page="@DepAdminModeEditQebiRoles">Edit Roles</a>
      <span> | </span>
      <a asp-page="@DepAdminModeViewQebiUsers">View Users</a>
      <span> | </span>
      <a asp-page="@DepAdminModeEditQebiUsers">Edit Users</a>
      @if (PDPSS.AppUseDevtestFeature)
      {
        <span> | </span>
        <a asp-page="@DepAdminModeCheckQebiUser" asp-route-ugk="@wrace.ClientUserKey"
           asp-route-agk="@wrace.ClientAgentKey" asp-route-sgk="@wrace.ClientSessionKey">Check QEBI User</a>
        <span> | </span>
        <a asp-page="@DepAdminModeCheckNpdsAgent" asp-route-ugk="@wrace.ClientUserKey"
           asp-route-agk="@wrace.ClientAgentKey" asp-route-sgk="@wrace.ClientSessionKey">Check NPDS Agent</a>
      }
    </span>
  }
}
