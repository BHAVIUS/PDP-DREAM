@{
  bool userAuth = (Model.QebiRcp.IsAuthenticated ?? false);
  PdpSiteRazorModel psrm = Model.PSRM;
  NpdsClientWrace npdscw = Model.NPDSCW;
}
@if (!string.IsNullOrEmpty(psrm.RazorBodyMenu))
{
  <p><partial name="@psrm.RazorBodyMenu" /></p>
}
@Html.Raw(psrm.FormatBodyTitle())

@if (userAuth && PDPSS.AppUseDevtestFeature)
{
  <h5>NPDS Agent from Core Repository</h5>

  <p>UserName: @npdscw.CiaamUserName</p>
  <p>UserAlias: @npdscw.CiaamUserAlias, RandAlias: @npdscw.CiaamRandAlias</p>
  <p>Guids from webapp cookies, keys from request querystring.</p>
  <p>User: Guid = @npdscw.CiaamUserGuid, Key = @npdscw.ClientUserKey</p>
  <p>Agent: Guid = @npdscw.CiaamAgentGuid, Key = @npdscw.ClientAgentKey</p>

  <p>
    NPDS Agent HasRole: Agent = @npdscw.ClientIsNpdsAgent,
    Author = @npdscw.ClientIsNpdsAuthor, Reviewer = @npdscw.ClientIsNpdsReviewer,
    Editor = @npdscw.ClientIsNpdsEditor, Publisher = @npdscw.ClientIsNpdsPublisher, Admin = @npdscw.ClientIsNpdsAdmin
  </p>

  <p>
    NPDS Agent HasMode: Agent = @npdscw.ClientHasAgentMode,
    Author = @npdscw.ClientHasAuthorMode, Reviewer = @npdscw.ClientHasReviewerMode,
    Editor = @npdscw.ClientHasEditorMode, Publisher = @npdscw.ClientHasPublisherMode, Admin = @npdscw.ClientHasAdminMode
  </p>

  <p>
    NPDS Agent CanWrite: Agent = @npdscw.ClientCanAgentWrite,
    Author = @npdscw.ClientCanAuthorWrite, Reviewer = @npdscw.ClientCanReviewerWrite,
    Editor = @npdscw.ClientCanEditorWrite, Publisher = @npdscw.ClientCanPublisherWrite, Admin = @npdscw.ClientCanAdminWrite
  </p>
}
