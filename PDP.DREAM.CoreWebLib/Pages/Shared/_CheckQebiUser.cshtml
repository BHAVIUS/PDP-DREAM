@{
  bool userAuth = (Model.QebRcp.IsAuthenticated ?? false);
  PdpSiteRazorModel psrm = Model.PSRM;
  NpdsClientWrace wrace = Model.WRACE;
}
@if (!string.IsNullOrEmpty(psrm.RazorBodyMenu))
{
  <p><partial name="@psrm.RazorBodyMenu" /></p>
}
@Html.Raw(psrm.FormatBodyTitle())

@if (userAuth && PDPSS.AppUseDevtestFeature)
{
  <h5>QEBI User from CIAAM Repository</h5>

  <p>UserName: @wrace.CiaamUserName, UserAlias: @wrace.CiaamUserAlias</p>
  <p>Guids from webapp cookies, keys from request querystring.</p>
  <p>User: Guid = @wrace.QebiUserGuid, Key = @wrace.ClientUserKey</p>
  <p>Agent: Guid = @wrace.NpdsAgentGuid, Key = @wrace.ClientAgentKey</p>
  <p>Session: Guid = @wrace.CiaamSessionGuid, Key = @wrace.ClientSessionKey</p>

  <p>
    QEBI User HasRole: User = @wrace.ClientIsUser, Agent = @wrace.ClientIsAgent,
    Author = @wrace.ClientIsAuthor, Reviewer = @wrace.ClientIsReviewer, 
    Editor = @wrace.ClientIsEditor, Admin = @wrace.ClientIsAdmin
  </p>

  <p>
    QEBI User HasMode: User = @wrace.ClientHasUserMode, Agent = @wrace.ClientHasAgentMode,
    Author = @wrace.ClientHasAuthorMode, Reviewer = @wrace.ClientHasReviewerMode, 
    Editor = @wrace.ClientHasEditorMode, Admin = @wrace.ClientHasAdminMode
  </p>
}
