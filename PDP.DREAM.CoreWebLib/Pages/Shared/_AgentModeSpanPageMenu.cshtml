@{
  bool userAuth = (Model.QebRcp.IsAuthenticated ?? false);
  string userName = (User?.Identity?.Name ?? ESS);
  NpdsClientWrace wrace = Model.WRACE;
  var keys = new Dictionary<string, string>() { ["ugk"] = wrace.ClientUserKey, ["agk"] = wrace.ClientAgentKey, ["sgk"] = wrace.ClientSessionKey };
  if (userAuth)
  {
    <span>
      AgentMode:
      <a asp-page="@DepAgentModeIndex" asp-all-route-data="@keys">Index</a>
      <span> | </span>
      <a asp-page="@DepAgentModeHelp">Help</a>
      <span> | </span>
      <a asp-page="@DepAgentModeAddRoleAgent">Add Role Agent</a>
      <span> | </span>
      <a asp-page="@DepAgentModeAddRoleAuthor">Add Role Author</a>
      <span> | </span>
      <a asp-page="@DepAgentModeAddRoleReviewer">Add Role Reviewer</a>
      <span> | </span>
      <a asp-page="@DepAgentModeAddRoleEditor">Add Role Editor</a>
      @if (PDPSS.AppUseDevtestFeature)
      {
        <span> | </span>
        <a asp-page="@DepAgentModeCheckQebiUser" asp-route-ugk="@wrace.ClientUserKey"
           asp-route-agk="@wrace.ClientAgentKey" asp-route-sgk="@wrace.ClientSessionKey">Check QEBI User</a>
        <span> | </span>
        <a asp-page="@DepAgentModeCheckNpdsAgent" asp-route-ugk="@wrace.ClientUserKey"
           asp-route-agk="@wrace.ClientAgentKey" asp-route-sgk="@wrace.ClientSessionKey">Check NPDS Agent</a>
      }
    </span>
  }
}
