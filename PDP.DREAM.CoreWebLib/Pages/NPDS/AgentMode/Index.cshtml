@page
@attribute [PdpRazorPageRoute(DepCoreWebLib, DepAgentModeIndex)]
@model AgentModeIndex
@{
  PdpSiteRazorModel psrm = Model.PSRM;
  PdpSiteInfoModel psim = psrm.PdpSiteInfo;
