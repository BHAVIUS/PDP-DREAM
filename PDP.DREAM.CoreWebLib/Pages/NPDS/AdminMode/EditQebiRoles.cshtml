@page
@attribute [PdpRazorPageRoute(DepCoreWebLib, DepAdminModeEditQebiRoles)]
@model AdminModeEditQebiRoles
@{
  PdpSiteRazorModel psrm = Model.PSRM;
  NpdsClientWrace wrace = Model.WRACE;
  bool userAuth = wrace.ClientIsAuthenticated;
}
@Html.Raw(psrm.FormatBodyTitle())
@if (!string.IsNullOrEmpty(psrm.RazorBodyMenu))
{ <p><partial name="@psrm.RazorBodyMenu" /></p> }

<div id="CiaaGrid">
@(Html.Kendo()
.Grid<QebiAppRoleUxm>()
.Name("QebiGrid")
.HtmlAttributes(new { style = "float:left;" })
.DataSource(ds => ds.Ajax().PageSize(10)
.Model(m => {
m.Id(p => p.RoleGuid);
m.Field(p => p.AppGuid).Editable(false).DefaultValue(EGS);
m.Field(p => p.RoleGuid).Editable(false).DefaultValue(EGS);
m.Field(p => p.RoleName).Editable(true).DefaultValue(String.Empty);
m.Field(p => p.AppRoleComment).Editable(true).DefaultValue(String.Empty);
}) // end Model
.Read(post => post.Url(psrm.RazorPagePath + "?handler=ReadQebiRoles").Data("kendoToken"))
.Create(post => post.Url(psrm.RazorPagePath + "?handler=WriteQebiRole").Data("kendoToken"))
.Update(post => post.Url(psrm.RazorPagePath + "?handler=WriteQebiRole").Data("kendoToken"))
.Destroy(post => post.Url(psrm.RazorPagePath + "?handler=DeleteQebiAppRole").Data("kendoToken"))
.Events(e => e.Error("HandleAjaxErrors"))
) // end DataSource
.Columns(col => {
col.Bound(row => row.AppGuid).Hidden(true);
col.Bound(row => row.RoleGuid).Hidden(true);
col.Bound(row => row.RoleName).Title("Name");
col.Bound(row => row.AppRoleComment).Title("Description");
col.Command(com => {
com.Edit();
com.Destroy();
}).Title(""); // end Command
}) // end Columns
.ToolBar(tb => tb.Create())
.Editable(ed => ed.Mode(GridEditMode.InLine))
.Pageable(pg => pg.AlwaysVisible(true).Responsive(false).Info(true).Refresh(true)
.Position(GridPagerPosition.Top).ButtonCount(3).PageSizes(new[] { 10, 30, 50 }))
.Sortable(st => st.SortMode(GridSortMode.SingleColumn).ShowIndexes(false).AllowUnsort(false))
.Filterable().Resizable(rs => rs.Columns(true)))
</div>

<script type="text/javascript">
$(document).ready(function () {
$("#CiaaGrid").show();
$("#QebiGrid").data("kendoGrid").resize();
})
</script>

