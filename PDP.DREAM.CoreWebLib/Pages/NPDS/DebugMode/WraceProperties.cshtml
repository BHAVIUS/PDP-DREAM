@page
@attribute [PdpRazorPageRoute(DepCoreWebLib, DepDebugModeWraceProperties)]
@model DebugModeWraceProperties
@{
  PdpSiteRazorModel psrm = Model.PSRM;
  NpdsClientWrace npdscw = Model.NPDSCW;
  var propList = npdscw.GetType().GetProperties().OrderBy(p => p.Name);
}
@Html.Raw(psrm.FormatBodyTitle())
@if (!string.IsNullOrEmpty(psrm.RazorBodyMenu))
{
   <p><partial name="@psrm.RazorBodyMenu" /></p>
}
@Html.Raw(psrm.FormatSectionTitle("Web REST API Controller Environment (WRACE) table of object properties"))

<table class="pdpTable">
  <tr><td>Name</td><td>Value</td><td>Type</td></tr>
  @foreach (PropertyInfo item in propList)
  {
    <tr><td>@item?.Name</td><td>@item?.GetValue(npdscw)?.ToString()</td><td>@item?.PropertyType</td></tr>
  }
</table>
