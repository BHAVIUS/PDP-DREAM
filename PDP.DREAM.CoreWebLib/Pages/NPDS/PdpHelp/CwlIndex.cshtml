@page
@attribute [PdpRazorPageRoute(DepCoreWebLib, DepCoreWebLibIndex)]
@model CoreWebLibIndex
@{
  PdpSiteRazorModel psrm = Model.PSRM;
  NpdsClientWrace npdscw = Model.NPDSCW;
  bool userAuth = npdscw.ClientIsAuthenticated;
}
@Html.Raw(psrm.FormatBodyTitle())
@if (!string.IsNullOrEmpty(psrm.RazorBodyMenu))
{
  <p><partial name="@psrm.RazorBodyMenu" /></p>
}

<h5>Help Info and Examples by NPDS RecordAccess</h5>

<ul>
  <li>Agent: <a asp-page="@DepnAgentModeHelp">@DepnAgentModeHelp</a></li>
  <li>Author: <a asp-page="@DepnAuthorModeHelp">@DepnAuthorModeHelp</a></li>
  <li>Reviewer: <a asp-page="@DepnReviewerModeHelp">@DepnReviewerModeHelp</a></li>
  <li>Editor: <a asp-page="@DepnEditorModeHelp">@DepnEditorModeHelp</a></li>
  <li>Admin: <a asp-page="@DepnAdminModeHelp">@DepnAdminModeHelp</a></li>
</ul>
