@page
@attribute [PdpRazorPageRoute(DepCoreWebLib, DepPdpInfoEntities)]
@model PdpInfoEntities
@{
  PdpSiteRazorModel psrm = Model.PSRM;
}
@Html.Raw(psrm.FormatBodyTitle())
@if (!string.IsNullOrEmpty(psrm.RazorBodyMenu))
{
  <p><partial name="@psrm.RazorBodyMenu" /></p>
}

<h4>NPDS Entity Types</h4>

<kendo-grid name="EntityTypes">
  <datasource type="DataSourceTagHelperType.Ajax" page-size="111">
    <schema>
      <model id="CodeKey" />
    </schema>
    <transport>
      <read url="@Url.Page(psrm.RazorPagePath,"Read")" data="kendoToken" />
    </transport>
  </datasource>
  <columns>
    <column field="TypeName" title="Type Name" header-html-attributes='new Dictionary<String,Object>{ ["title"] = "Name of EntityType" }' />
    <column field="TypeDescription" title="Type Description" header-html-attributes='new Dictionary<String,Object>{ ["title"] = "Description of EntityType" }' />
    <column field="TypeEditedByAgent" title="Agent" header-html-attributes='new Dictionary<String,Object>{ ["title"] = "Editable by Agent" }' />
    <column field="TypeEditedByAuthor" title="Author" header-html-attributes='new Dictionary<String,Object>{ ["title"] = "Editable by Author" }' />
    <column field="TypeEditedByReviewer" title="Reviewer" header-html-attributes='new Dictionary<String,Object>{ ["title"] = "Editable by Reviewer" }' />
    <column field="TypeEditedByEditor" title="Editor" header-html-attributes='new Dictionary<String,Object>{ ["title"] = "Editable by Editor" }' />
    <column field="TypeEditedByAdmin" title="Admin" header-html-attributes='new Dictionary<String,Object>{ ["title"] = "Editable by Administrator" }' />
  </columns>
  <resizable enabled="true" columns="true" />
  <sortable enabled="true" />
</kendo-grid>
