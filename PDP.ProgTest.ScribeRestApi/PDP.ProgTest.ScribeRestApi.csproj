<Project Sdk="Microsoft.NET.Sdk.Web">

  <!-- project declaration -->
  <PropertyGroup>
    <AssemblyName>PDP.ProgTest.ScribeRestApi</AssemblyName>
    <RootNamespace>PDP.DREAM.ScribeRestApi</RootNamespace>
    <Description>PDP-DREAM ScribeRestApi</Description>
    <IsPackable>false</IsPackable>
  </PropertyGroup>

  <!-- dev/test/build/debug configuration -->
  <PropertyGroup>
    <Deterministic>false</Deterministic>
    <NoWarn>CS8032;CS8600;CS8601;CS8602;CS8604;</NoWarn>
  </PropertyGroup>
  <ItemGroup>
    <PackageReference Include="xunit" Version="2.7.1" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.8">
      <PrivateAssets>all</PrivateAssets>
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- required references -->
  <ItemGroup>
    <ProjectReference Include="..\PDP.DREAM.ScribeWebLib\PDP.DREAM.ScribeWebLib.csproj" />
  </ItemGroup>

</Project>

