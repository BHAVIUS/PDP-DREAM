    <DataPropertyAssertion>
        <DataProperty IRI="#accessURL"/>
        <NamedIndividual IRI="#BrainWatch"/>
        <Literal xml:lang="en">https://www.brainhealthalliance.net/AnonResreps/NpdsView/Nexus/BrainWatch</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#accessURL"/>
        <NamedIndividual IRI="#DaVinci"/>
        <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#anyURI">https://www.portaldoors.net/AnonResreps/NpdsView/Nexus/DaVinci</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#accessURL"/>
        <NamedIndividual IRI="#GeneScene"/>
        <Literal datatypeIRI="http://www.w3.org/2001/XMLSchema#anyURI">https://www.telegenetics.net/AnonResreps/NpdsView/Nexus/GeneScene</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#Language"/>
        <NamedIndividual IRI="#PDP-Aoraki"/>
        <Literal>C# / .NET Core</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#Language"/>
        <NamedIndividual IRI="#PDP-Meru"/>
        <Literal>MEAN Stack (MongoDB, Express, Angular.js, Node.js)</Literal>
    </DataPropertyAssertion>
    <DataPropertyAssertion>
        <DataProperty IRI="#Language"/>
        <NamedIndividual IRI="#PDP-Zunil"/>
        <Literal>Python</Literal>
    </DataPropertyAssertion>
