#    Individuals
#################################################################

###  http://npds.portaldoors.org/schema/pdp/npds#BrainWatch
npds:BrainWatch rdf:type owl:NamedIndividual ;
                npds:accessURL "https://www.brainhealthalliance.net/AnonResreps/NpdsView/Nexus/BrainWatch"@en ;
                rdfs:comment "BrainWatch is a Nexus diristry dedicated to the storage of resources relevant to the BrainWatch project. As such, it contains resources such as co-registration algorithms and image databases."@en .


###  http://npds.portaldoors.org/schema/pdp/npds#DaVinci
npds:DaVinci rdf:type owl:NamedIndividual ,
                      npds:Nexus ;
             npds:accessURL "https://www.portaldoors.net/AnonResreps/NpdsView/Nexus/DaVinci"^^xsd:anyURI ;
             rdfs:comment "DaVinci is a Nexus diristry dedicated to the accumulation of resources relevant to the Nexus PORTAL-DOORS System and relevant projects. As such, it primarily consists of knowledge engineering, semantic web, and symbolic systems resources."@en .


###  http://npds.portaldoors.org/schema/pdp/npds#GeneScene
npds:GeneScene rdf:type owl:NamedIndividual ,
                        npds:Nexus ;
               npds:accessURL "https://www.telegenetics.net/AnonResreps/NpdsView/Nexus/GeneScene"^^xsd:anyURI ;
               rdfs:comment "GeneScene is a Nexus diristry about organizations which relate to genetic diseases and testing. As such, it primarily contains information about things such as Gene Testing clinics and organizations which relate to genetic diseases."@en .


###  http://npds.portaldoors.org/schema/pdp/npds#PDP-Aoraki
npds:PDP-Aoraki rdf:type owl:NamedIndividual ,
                         npds:NPDS ;
                npds:Language "C# / .NET Core" ;
                rdfs:comment "PDP-Aoraki is the oldest implementation of NPDS and is based off of the Microsoft C#/.NET stack."@en .


###  http://npds.portaldoors.org/schema/pdp/npds#PDP-Meru
npds:PDP-Meru rdf:type owl:NamedIndividual ,
                       npds:NPDS ;
              npds:Language "MEAN Stack (MongoDB, Express, Angular.js, Node.js)" ;
              rdfs:comment "PDP-Meru is the second implementation of the Nexus PORTAL-DOORS System. It is implemented in the MEAN (MongoDB, Express, Angular, Node.js) stack implementation."@en .


###  http://npds.portaldoors.org/schema/pdp/npds#PDP-Zunil
npds:PDP-Zunil rdf:type owl:NamedIndividual ,
                        npds:NPDS ;
               npds:Language "Python" ;
               rdfs:comment "PDP-Zunil is the newest NPDS implementation. It is implemented in the Python DAC stack."@en .


