@page
@attribute [PdpRazorPageRoute(DepNpdsWebLib, DepqUserModeChangeUsername)]
@model QebiUserModeChangeUsername
@{
  PdpSiteRazorModel psrm = Model.PSRM;
  NpdsClientWrace npdscw = Model.NPDSCW;
  var pdpFormGroup = "form-group mb-3 col-md-3";
}
@Html.Raw(psrm.FormatBodyTitle())
@if (!string.IsNullOrEmpty(psrm.RazorBodyMenu))
{
   <p><partial name="@psrm.RazorBodyMenu" /></p>
}

@if (Model.UXM.FormCompleted)
{
  <p class="pdpTaskPassed">
    Your username has been changed.
    You may now <a asp-page="@DepqAnonModeLoginUser">login</a> again with your new username.
  </p>
}
else
{
  <form id="frmChangeUsername" asp-page="DepqUserModeChangeUsernamee"
        method="post" role="form" class="form-horizontal">
    <p>
      Use the form below to change your username.
    </p>
    <div class="@pdpFormGroup">
      @Html.AntiForgeryToken()
      @Html.HiddenFor(m => m.UXM.FormTitle, new { Value = Model.UXM.FormTitle })
      @Html.HiddenFor(m => m.UXM.RequireSecTok, new { Value = Model.UXM.RequireSecTok })
      @Html.HiddenFor(m => m.UXM.SecurityToken, new { Value = Model.UXM.SecurityToken })
      @Html.HiddenFor(m => m.UXM.UserGuid, new { Value = Model.UXM.UserGuid })
      @Html.HiddenFor(m => m.UXM.UserName, new { Value = Model.UXM.UserName })
      @Html.ValidationSummary("", new { @class = "text-danger" })
    </div>
    <div class="@pdpFormGroup">
      @Html.LabelFor(m => m.UXM.OldUsername, new { @class = "form-label" })
      @Html.TextBoxFor(m => m.UXM.OldUsername, new { @class = "form-control" })
      @Html.ValidationMessageFor(m => m.UXM.OldUsername, null, new { @class = "form-label text-danger" })
    </div>
    <div class="@pdpFormGroup">
      @Html.LabelFor(m => m.UXM.NewUsername, new { @class = "form-label" })
      @Html.TextBoxFor(m => m.UXM.NewUsername, new { @class = "form-control" })
      @Html.ValidationMessageFor(m => m.UXM.NewUsername, null, new { @class = "form-label text-danger" })
    </div>
    <div class="@pdpFormGroup">
      @Html.LabelFor(m => m.UXM.AltUsername, new { @class = "form-label" })
      @Html.TextBoxFor(m => m.UXM.AltUsername, new { @class = "form-control" })
      @Html.ValidationMessageFor(m => m.UXM.AltUsername, null, new { @class = "form-label text-danger" })
    </div>
    <div class="@pdpFormGroup">
      @Html.LabelFor(m => m.UXM.PassWord, new { @class = "form-label" })
      @Html.PasswordFor(m => m.UXM.PassWord, new { @class = "form-control" })
      @Html.ValidationMessageFor(m => m.UXM.PassWord, null, new { @class = "form-label text-danger" })
    </div>
    <br />
    <button id="btnChangeUsername" type="submit" class="btn btn-outline-primary">Change Username</button>
  </form>
}

