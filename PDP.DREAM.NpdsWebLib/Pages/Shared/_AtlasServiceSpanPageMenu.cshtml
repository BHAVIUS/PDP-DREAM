@{
  bool userAuth = (Model.QebiRcp.IsAuthenticated ?? false);
  string userName = (Model.QebiRcp.UserName ?? ESS);
  string paramsPath = (Model.NPDSCW.ResrepSrch4ParamPP ?? ESS);
  string anonResreps = DepNexusServiceAnonResreps + paramsPath;
  // ATTN: use href attribute for links not registered with RazorPage names
  <span>
    Atlas:
    <a asp-page="@DepAtlasServiceIndex">Index</a>
    <span> | </span>
    <a href="@DepAtlasServiceAnonResreps">Anon</a>
    @if (userAuth)
    {
      string readerResreps = DepAtlasServiceReaderResreps + paramsPath;
      string agentResreps = DepAtlasServiceAgentResreps + paramsPath;
      string authorResreps = DepAtlasServiceAuthorResreps + paramsPath;
      string reviewerResreps = DepAtlasServiceReviewerResreps + paramsPath;
      string editorResreps = DepAtlasServiceEditorResreps + paramsPath;
      string adminResreps = DepAtlasServiceAdminResreps + paramsPath;
      <span> | </span>
      <a href="@readerResreps">Reader</a>
      <span> | </span>
      <a href="@agentResreps">Agent</a>
      <span> | </span>
      <a href="@authorResreps">Author</a>
      <span> | </span>
      <a href="@reviewerResreps">Reviewer</a>
      <span> | </span>
      <a href="@editorResreps">Editor</a>
      <span> | </span>
      <a href="@adminResreps">Admin</a>
    }
  </span>
}
