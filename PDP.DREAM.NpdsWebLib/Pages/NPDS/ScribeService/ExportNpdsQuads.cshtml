@page "{recordAccess?}"
@attribute [PdpRazorPageRoute(DepNpdsWebLib, DepScribeServiceExportNpdsQuads)]
@model ScribeServiceExportNpdsQuads
@{
  PdpSiteRazorModel psrm = Model.PSRM;
  NpdsClientWrace npdscw = Model.NPDSCW;
  bool userAuth = npdscw.ClientIsAuthenticated;
  // TODO: convert DiristryList to some analogous equivalent usable by GetEnumSelectList
  // TODO: write a PDP variant of GetEnumSelectList sourced dynamically from database
  IEnumerable<SelectListItem>? DiristryList = NPDSCD.NpdsDdlists.RegcDiristryList;
  var DiristryLabel = "Select diristry";
  // var BcrFormatList = Html.GetEnumSelectList<BcrConstants.BbnewtFormatName>();
  // var BcrFormatLabel = "Select format";
  // column formatting
  var PdpUtcdtFormat = "{0:yyyy-MM-dd HH:mm}";
  var PdpNumF3Format = "{0:n3}";
  var pdpFormGroup = "form-group mb-3";
  var labelNormal = "form-label col-md-3";
  var controlNormal = "form-control col-md-3";
  var warningMessage = labelNormal + " text-danger";
  var labelWide = "form-label col-md-6";
  var controlWide = "form-control col-md-6";
}
@Html.Raw(psrm.FormatBodyTitle())
@if (!string.IsNullOrEmpty(psrm.RazorBodyMenu))
{
  <p><partial name="@psrm.RazorBodyMenu" /></p>
}
@Html.Raw(psrm.FormatBodyTitle(npdscw.RecordAccess.EName + " Export Metadata Records by BibCitRef File"))

<p>
  This form must be used with selection of a Nexus diristry.
</p>

<form id="frmScribeService"
  method="post" role="form" class="form-horizontal"
  asp-page="@psrm.RazorPageName">
  <div class="@pdpFormGroup">
    @Html.AntiForgeryToken()
    @Html.HiddenFor(m => m.UXM.RRRecordAccess)
    @Html.ValidationSummary("", new { @class = warningMessage })
  </div>
  <br />
  <button id="btnScribeService" type="submit" class="btn btn-outline-primary">Export Metadata Records</button>
</form>
