<Project Sdk="Microsoft.NET.Sdk.Razor">

  <!-- project declaration -->
  <PropertyGroup>
    <AssemblyName>PDP.DREAM.NpdsDataLib</AssemblyName>
    <RootNamespace>PDP.DREAM.NpdsDataLib</RootNamespace>
