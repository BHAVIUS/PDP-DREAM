            <menu-item text="Add Agent Role" url="@DepnAgentModeAddRoleAgent" />
            <menu-item text="Add Author Role" url="@DepnAgentModeAddRoleAuthor" />
            <menu-item text="Add Reviewer Role" url="@DepnAgentModeAddRoleReviewer" />
            <menu-item text="Add Editor Role" url="@DepnAgentModeAddRoleEditor" />
          }
          <menu-item text="Contact Site" url="@DepqUserModeContactSite" />
          <menu-item text="Logout User" url="@DepqUserModeLogoutUser" />
        </sub-items>
      </menu-item>
    }
    else
    {
      <menu-item text="User" url="@DepqAnonModeIndex">
        <sub-items>
          <menu-item text="Login User" url="@DepqAnonModeLoginUser" />
          <menu-item text="Register User" url="@DepqAnonModeRegisterUser" />
        </sub-items>
      </menu-item>
