@{
  string appName = (Model.PSRM.SiteAppName ?? ESS);
  bool userAuth = (Model.QebiRcp.IsAuthenticated ?? false);
  string userName = (Model.QebiRcp.UserName ?? ESS);
}

<span>
  @appName:
  <a asp-page="@DepPdpHomeIndex">PdpHome</a>
  <span> | </span>
  <a asp-page="@DepPdpInfoIndex">PdpInfo</a>
  <span> | </span>
  <a asp-page="@DepCoreWebLibIndex">CoreWebLib</a>
  <span> | </span>
  @if (userAuth)
  {
    <a asp-page="@DepqUserModeIndex">UserMode</a>
    <span> | </span>
    <a asp-page="@DepCoreWebLibHelp">Help</a>
    @if (PDPSS.AppUseDevtestFeature)
    {
      <span> | </span>
      <a asp-page="@DepCoreWebLibTest">Test</a>
    }
    <span> | </span>
    <a asp-page="@DepqUserModeDisplayProfile">@userName</a>
  }
  else
  {
    <a asp-page="@DepqAnonModeIndex">AnonMode</a>
    <span> | </span>
    <a asp-page="@DepqAnonModeLoginUser">Login</a>
  }
</span>

