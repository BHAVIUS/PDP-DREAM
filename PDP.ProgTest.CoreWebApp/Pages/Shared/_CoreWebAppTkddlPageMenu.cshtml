<kendo-menu name="CoreWebAppTkddlPageMenu"
            direction="MenuDirection.Right" style="float:left"
            orientation="MenuOrientation.Horizontal">
  <items>
    <menu-item text="NPDS" url="/CwaHome/Index">
      <sub-items>
        <menu-item text="NPDS Info" url="@DepPdpSiteInfo" />
        <menu-item text="NPDS Design" url="@DepPdpSiteDesign" />
        <menu-item text="NPDS Papers" url="@DepPdpSitePapers" />
        <menu-item text="NPDS Home" url="https://www.npdslinks.org/" rel="external" target="_blank" />
        <menu-item text="NPDS Registrar" url="https://www.npdslinks.net/" rel="external" target="_blank" />
        <menu-item text="BHA Home" url="https://www.brainhealthalliance.org/" rel="external" target="_blank" />
        <menu-item text="BHA Registrar" url="https://www.brainhealthalliance.net/" rel="external" target="_blank" />
        <menu-item text="GTG Home" url="https://www.telegenetics.com/" rel="external" target="_blank" />
        <menu-item text="GTG Registrar" url="https://www.telegenetics.net/" rel="external" target="_blank" />
        <menu-item text="PDP Home" url="https://www.portaldoors.org/" rel="external" target="_blank" />
        <menu-item text="PDP Registrar" url="https://www.portaldoors.net/" rel="external" target="_blank" />
      </sub-items>
    </menu-item>
    @if (Model.QebRcp.IsAuthenticated ?? false)
    {
      <menu-item text="@Model.QebRcp.UserName" url="@DepUserModeIndex">
        <sub-items>
          <menu-item text="Display Profile" url="@DepUserModeDisplayProfile" />
          <menu-item text="Change Profile" url="@DepUserModeChangeProfile" />
          <menu-item text="Change Email" url="@DepUserModeChangeEmail" />
          <menu-item text="Change Password" url="@DepUserModeChangePassword" />
          <menu-item text="Change Username" url="@DepUserModeChangeUsername" />
          <menu-item text="View Agent Index" url="@DepAgentModeIndex" />
          <menu-item text="Add Agent Role" url="@DepAgentModeAddRoleAgent" />
          <menu-item text="Add Author Role" url="@DepAgentModeAddRoleAuthor" />
          <menu-item text="Add Reviewer Role" url="@DepAgentModeAddRoleReviewer" />
          <menu-item text="Add Editor Role" url="@DepAgentModeAddRoleEditor" />
          <menu-item text="Contact Site" url="@DepUserModeContactSite" />
          <menu-item text="Logout User" url="@DepUserModeLogoutUser" />
        </sub-items>
      </menu-item>
    }
    else
    {
      <menu-item text="User" url="/QEBI/AnonMode/Index">
        <sub-items>
          <menu-item text="Login User" url="@DepAnonModeLoginUser" />
          <menu-item text="Register User" url="@DepAnonModeRegisterUser" />
        </sub-items>
      </menu-item>
    }
    @if (Model.QebRcp.IsInRole(NpdsAdmin))
    {
      <menu-item text="Admin" url="/NPDS/NexusService/AdminResreps">
        <sub-items>
          <menu-item text="Core Read">
            <sub-items>
              <menu-item text="NPDS-Root" url="/NPDS/CoreService/AdminResreps/Diristry/NPDS-Root" />
              <menu-item text="BHA-Nexus" url="/NPDS/CoreService/AdminResreps/Diristry/BHA-Nexus" />
              <menu-item text="BHA-PORTAL" url="/NPDS/CoreService/AdminResreps/Registry/BHA-PORTAL" />
              <menu-item text="BHA-DOORS" url="/NPDS/CoreService/AdminResreps/Directory/BHA-DOORS" />
              <menu-item text="BHA-Scribe" url="/NPDS/CoreService/AdminResreps/Registrar/BHA-Scribe" />
              <menu-item text="GTG-Nexus" url="/NPDS/CoreService/AdminResreps/Diristry/GTG-Nexus" />
              <menu-item text="GTG-PORTAL" url="/NPDS/CoreService/AdminResreps/Registry/GTG-PORTAL" />
              <menu-item text="GTG-DOORS" url="/NPDS/CoreService/AdminResreps/Directory/GTG-DOORS" />
              <menu-item text="GTG-Scribe" url="/NPDS/CoreService/AdminResreps/Registrar/GTG-Scribe" />
              <menu-item text="PDP-Nexus" url="/NPDS/CoreService/AdminResreps/Diristry/PDP-Nexus" />
              <menu-item text="PDP-PORTAL" url="/NPDS/CoreService/AdminResreps/Registry/PDP-PORTAL" />
              <menu-item text="PDP-DOORS" url="/NPDS/CoreService/AdminResreps/Directory/PDP-DOORS" />
              <menu-item text="PDP-Scribe" url="/NPDS/CoreService/AdminResreps/Registrar/PDP-Scribe" />
              <menu-item text="PDP-DREAM" url="/NPDS/CoreService/AdminResreps/Diristry/PDP-DREAM" />
            </sub-items>
          </menu-item>
          <menu-item text="Manage NPDS">
            <sub-items>
              <menu-item text="Core Service" url="@DepCoreServiceIndex" />
              <menu-item text="Users and Roles" url="@DepAdminModeIndex" />
            </sub-items>
          </menu-item>
        </sub-items>
      </menu-item>
    }
  </items>
</kendo-menu>
