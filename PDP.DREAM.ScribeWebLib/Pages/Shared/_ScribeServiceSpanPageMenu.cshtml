@{
  bool userAuth = (Model.QebiRcp.IsAuthenticated ?? false);
  string userName = (Model.QebiRcp.UserName ?? ESS);
  <span>
    ScribeService:
    <a href="@DepScribeServiceIndex">Index</a>
    @if (userAuth)
    {
      string paramsPath = (Model.NPDSCW.ResrepSrch4ParPartPath ?? ESS);
      string agentResreps = DepScribeServiceAgentResreps + paramsPath;
      string authorResreps = DepScribeServiceAuthorResreps + paramsPath;
      string reviewerResreps = DepScribeServiceReviewerResreps + paramsPath;
      string editorResreps = DepScribeServiceEditorResreps + paramsPath;
      string adminResreps = DepScribeServiceAdminResreps + paramsPath;
      <span> | </span>
      <a href="@agentResreps">AgentResreps</a>
      <span> | </span>
      <a href="@authorResreps">AuthorResreps</a>
      <span> | </span>
      <a href="@reviewerResreps">ReviewerResreps</a>
      <span> | </span>
      <a href="@editorResreps">EditorResreps</a>
      <span> | </span>
      <a href="@adminResreps">AdminResreps</a>
    }
  </span>
}
